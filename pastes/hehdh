-- keyboard up/down (PC): E naik, Q turun
track(UserInputService.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.KeyCode == Enum.KeyCode.E then vertical = 1
    elseif i.KeyCode == Enum.KeyCode.Q then vertical = -1 end
    if i.KeyCode == Enum.KeyCode.Space and S.infJump then
        local h = hum()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end))
track(UserInputService.InputEnded:Connect(function(i)
    if i.KeyCode == Enum.KeyCode.E and vertical == 1 then vertical = 0 end
    if i.KeyCode == Enum.KeyCode.Q and vertical == -1 then vertical = 0 end
end))
-- infinite jump (mobile / tombol lompat)
track(UserInputService.JumpRequest:Connect(function()
    if S.infJump then
        local h = hum()
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end))

-- ESP
local espObjs = {}
local function clearESP(plr)
    local o = espObjs[plr]
    if o then
        for _, x in pairs(o) do pcall(function() x:Destroy() end) end
        espObjs[plr] = nil
    end
end
local function applyESP(plr)
    clearESP(plr)
    if plr == LP or not S.esp then return end
    local c = plr.Character
    local head = c and c:FindFirstChild("Head")
    if not c or not head then return end
    local hl = make("Highlight", {
        Adornee = c, FillColor = C.accent, OutlineColor = Color3.new(1, 1, 1),
        FillTransparency = 0.6, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }, c)
    local bb = make("BillboardGui", {
        Adornee = head, Size = UDim2.fromOffset(140, 30), StudsOffset = Vector3.new(0, 2.5, 0),
        AlwaysOnTop = true,
    }, c)
    local t = make("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = plr.DisplayName,
        TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.3,
        Font = Enum.Font.GothamBold, TextSize = 13,
    }, bb)
    espObjs[plr] = {hl, bb, t}
end
local function refreshESP()
    for _, p in ipairs(Players:GetPlayers()) do applyESP(p) end
end
local function hookPlayer(p)
    track(p.CharacterAdded:Connect(function()
        task.wait(1)
        if S.esp then applyESP(p) end
    end))
end
for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
track(Players.PlayerAdded:Connect(hookPlayer))
track(Players.PlayerRemoving:Connect(clearESP))

-- ESP distance label update
task.spawn(function()
    while Gui.Parent do
        if S.esp then
            local r = hrp()
            for p, o in pairs(espObjs) do
                local pr = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if r and pr and o[3] then
                    o[3].Text = string.format("%s [%dm]", p.DisplayName, (r.Position - pr.Position).Magnitude)
                end
            end
        end
        task.wait(0.4)
    end
end)

-- Fullbright
local origLight
local function setFullbright(on)
    if on then
        origLight = origLight or {
            Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
            FogEnd = Lighting.FogEnd, GlobalShadows = Lighting.GlobalShadows,
            Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
        }
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1e6
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
        Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
    elseif origLight then
        for k, v in pairs(origLight) do Lighting[k] = v end
    end
end

-- Main loops
local origGravity = workspace.Gravity
local defaultFov = Camera.FieldOfView

track(RunService.Heartbeat:Connect(function()
    local h, r = hum(), hrp()
    if not h then return end

    if S.speedOn and not S.fly then h.WalkSpeed = S.speed end
    if S.jumpOn then
        h.UseJumpPower = true
        h.JumpPower = S.jump
    end
    if S.god then
        h.MaxHealth = math.huge
        h.Health = h.MaxHealth
    end
    if S.fovOn then Camera.FieldOfView = S.fov end
    if S.gravOn then workspace.Gravity = S.gravity end

    if S.fly and flyBV and flyBG and r then
        local cam = workspace.CurrentCamera
        local dir = h.MoveDirection * S.flySpeed
        flyBV.Velocity = dir + Vector3.new(0, vertical * S.flySpeed, 0)
        flyBG.CFrame = CFrame.new(r.Position, r.Position + cam.CFrame.LookVector * Vector3.new(1, 0, 1) + Vector3.new(0, 0.001, 0))
    end
end))

track(RunService.Stepped:Connect(function()
    if S.noclip then
        local c = char()
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
            end
        end
    end
end))

