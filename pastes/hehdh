local function Label(page, text)
    make("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = text,
        TextColor3 = C.dim, Font = Enum.Font.GothamBold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, page)
end

local function Toggle(page, text, default, cb)
    local f = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.item, Text = "",
        AutoButtonColor = false,
    }, page)
    corner(f, 8)
    make("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0), Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1, Text = text, TextColor3 = C.text,
        Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
    }, f)
    local pill = make("Frame", {
        Size = UDim2.fromOffset(38, 18), Position = UDim2.new(1, -46, 0.5, -9),
        BackgroundColor3 = C.off,
    }, f)
    corner(pill, 9)
    local dot = make("Frame", {
        Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = Color3.new(1, 1, 1),
    }, pill)
    corner(dot, 7)
    local state = default
    local function render()
        TweenService:Create(pill, TweenInfo.new(0.15), {BackgroundColor3 = state and C.accent or C.off}):Play()
        TweenService:Create(dot, TweenInfo.new(0.15), {Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)}):Play()
    end
    render()
    f.MouseButton1Click:Connect(function()
        state = not state
        render()
        cb(state)
    end)
    if default then cb(true) end
end

local function Slider(page, text, min, max, default, cb)
    local f = make("Frame", {Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = C.item}, page)
    corner(f, 8)
    local lbl = make("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 3),
        BackgroundTransparency = 1, Text = text .. ": " .. default,
        TextColor3 = C.text, Font = Enum.Font.Gotham, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, f)
    local bar = make("Frame", {
        Size = UDim2.new(1, -20, 0, 6), Position = UDim2.fromOffset(10, 30),
        BackgroundColor3 = C.off,
    }, f)
    corner(bar, 3)
    local fill = make("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = C.accent,
    }, bar)
    corner(fill, 3)
    local hit = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, -9),
        BackgroundTransparency = 1, Text = "",
    }, bar)

    local sliding = false
    local function setFromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * a + 0.5)
        fill.Size = UDim2.new(a, 0, 1, 0)
        lbl.Text = text .. ": " .. v
        cb(v)
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            setFromX(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFromX(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
end

local function Button(page, text, cb)
    local b = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.item, Text = text,
        TextColor3 = C.text, Font = Enum.Font.GothamBold, TextSize = 13,
    }, page)
    corner(b, 8)
    b.MouseButton1Click:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3 = C.accent}):Play()
        task.delay(0.15, function() TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = C.item}):Play() end)
        cb()
    end)
    return b
end

local function notify(msg)
    local n = make("TextLabel", {
        Size = UDim2.fromOffset(260, 34), Position = UDim2.new(0.5, -130, 0, -40),
        BackgroundColor3 = C.panel, Text = msg, TextColor3 = C.text,
        Font = Enum.Font.GothamBold, TextSize = 12,
    }, Gui)
    corner(n, 8)
    make("UIStroke", {Color = C.accent, Thickness = 1}, n)
    TweenService:Create(n, TweenInfo.new(0.3), {Position = UDim2.new(0.5, -130, 0, 14)}):Play()
    task.delay(2.5, function()
        TweenService:Create(n, TweenInfo.new(0.3), {Position = UDim2.new(0.5, -130, 0, -40)}):Play()
        task.delay(0.35, function() n:Destroy() end)
    end)
end

